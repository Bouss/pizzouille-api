###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# Exchange/queue topology is defined per transport in config/packages/messenger.yaml,
# so the DSN only needs to reach the broker vhost.
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f
###< symfony/messenger ###

###> meilisearch/meilisearch-php ###
MEILISEARCH_DSN=http://meilisearch:7700
MEILISEARCH_API_KEY=
###< meilisearch/meilisearch-php ###
